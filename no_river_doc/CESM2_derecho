cd $SCRIPT_DIR_BASE/$CASE 

./preview_namelists

# Make the diagnostics file case-specific.
cp Buildconf/popconf/ecosys_diagnostics   SourceMods/src.pop/ecosys_diagnostics

# Preserve the unmodified version.
cp SourceMods/src.pop/ecosys_diagnostics \
   SourceMods/src.pop/ecosys_diagnostics.original

# Turn off only these two output diagnostics.
sed -i \
  -e 's/^[[:space:]]*DOC_RIV_FLUX[[:space:]]*:.*$/DOC_RIV_FLUX : never_average/' \
  -e 's/^[[:space:]]*DOCr_RIV_FLUX[[:space:]]*:.*$/DOCr_RIV_FLUX : never_average/' \
  SourceMods/src.pop/ecosys_diagnostics

echo "Case-specific diagnostic settings:"
grep -E '^(DOC_RIV_FLUX|DOCr_RIV_FLUX)[[:space:]]*:' \
  SourceMods/src.pop/ecosys_diagnostics

# Regenerate configuration from the edited SourceMods file.
./preview_namelists

echo "Generated Buildconf diagnostic settings:"
grep -E '^(DOC_RIV_FLUX|DOCr_RIV_FLUX)[[:space:]]*:' \
  Buildconf/popconf/ecosys_diagnostics

