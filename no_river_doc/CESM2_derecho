cd /glade/work/jameslin/SourceCode_gx3v7

cp ocn.base.tavg.csh.annual ${SCRIPT_DIR_BASE}/${CASE}/SourceMods/src.pop/ocn.base.tavg.csh
cp user_nl_pop.annual.x3Feinputs ${SCRIPT_DIR_BASE}/${CASE}/user_nl_pop
cp user_nl_cice.annual ${SCRIPT_DIR_BASE}/${CASE}/user_nl_cice
cp user_nl_marbl_burial_p8poc ${SCRIPT_DIR_BASE}/${CASE}/user_nl_marbl
